<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:harp="clr-namespace:Bonsai.Harp;assembly=Bonsai.Harp"
                 xmlns:beh="clr-namespace:Harp.Behavior;assembly=Harp.Behavior"
                 xmlns:p1="clr-namespace:Bonsai.Mixer;assembly=Bonsai.Mixer"
                 xmlns:dsp="clr-namespace:Bonsai.Dsp;assembly=Bonsai.Dsp"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="Annotation">
        <Text><![CDATA[Initialises and configures Harp BehaviorBoard for speaker playback]]></Text>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>BehaviorBoard</Name>
        <Workflow>
          <Nodes>
            <Expression xsi:type="Annotation">
              <Text><![CDATA[Receives and stores command messages from the BehaviorBoard]]></Text>
            </Expression>
            <Expression xsi:type="rx:BehaviorSubject" TypeArguments="harp:HarpMessage">
              <rx:Name>BehaviorCommands</rx:Name>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="PortName" />
            </Expression>
            <Expression xsi:type="Annotation">
              <Text><![CDATA[Initialises connection to BehaviorBoard and allows for configuration of board parameters]]></Text>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="beh:Device">
                <harp:OperationMode>Active</harp:OperationMode>
                <harp:OperationLed>On</harp:OperationLed>
                <harp:DumpRegisters>true</harp:DumpRegisters>
                <harp:VisualIndicators>On</harp:VisualIndicators>
                <harp:Heartbeat>Disabled</harp:Heartbeat>
                <harp:IgnoreErrors>false</harp:IgnoreErrors>
                <harp:PortName>COM3</harp:PortName>
              </Combinator>
            </Expression>
            <Expression xsi:type="Annotation">
              <Text><![CDATA[Publishes events received from board to other parts of the workflow]]></Text>
            </Expression>
            <Expression xsi:type="rx:PublishSubject">
              <Name>BehaviorEvents</Name>
            </Expression>
            <Expression xsi:type="Annotation">
              <Text><![CDATA[Takes events received from BehaviorBoard]]></Text>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>BehaviorEvents</Name>
            </Expression>
            <Expression xsi:type="Annotation">
              <Text><![CDATA[Takes limited number of initial event processing events during start up]]></Text>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Take">
                <rx:Count>10</rx:Count>
              </Combinator>
            </Expression>
            <Expression xsi:type="Annotation">
              <Text><![CDATA[Uses final event to trigger configuration of following]]></Text>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:TakeLast">
                <rx:Count>1</rx:Count>
              </Combinator>
            </Expression>
            <Expression xsi:type="Annotation">
              <Text><![CDATA[Clears previous digital output to ensure board starts in known state]]></Text>
            </Expression>
            <Expression xsi:type="beh:CreateMessage">
              <harp:MessageType>Write</harp:MessageType>
              <harp:Payload xsi:type="beh:CreateOutputClearPayload">
                <beh:OutputClear>DO2</beh:OutputClear>
              </harp:Payload>
            </Expression>
            <Expression xsi:type="Annotation">
              <Text><![CDATA[Enables pulse functionality on board]]></Text>
            </Expression>
            <Expression xsi:type="beh:CreateMessage">
              <harp:MessageType>Write</harp:MessageType>
              <harp:Payload xsi:type="beh:CreateOutputPulseEnablePayload">
                <beh:OutputPulseEnable>DO2</beh:OutputPulseEnable>
              </harp:Payload>
            </Expression>
            <Expression xsi:type="Annotation">
              <Text><![CDATA[Sets pulse duration for triggers]]></Text>
            </Expression>
            <Expression xsi:type="beh:CreateMessage">
              <harp:MessageType>Write</harp:MessageType>
              <harp:Payload xsi:type="beh:CreatePulseDO2Payload">
                <beh:PulseDO2>500</beh:PulseDO2>
              </harp:Payload>
            </Expression>
            <Expression xsi:type="Annotation">
              <Text><![CDATA[Combines configuration parameters into single stream ]]></Text>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Merge" />
            </Expression>
            <Expression xsi:type="Annotation">
              <Text><![CDATA[Adds delay before sending commands to ensure device is ready ]]></Text>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Delay">
                <rx:DueTime>PT0.1S</rx:DueTime>
              </Combinator>
            </Expression>
            <Expression xsi:type="Annotation">
              <Text><![CDATA[Executes merged command sequence and publishes to board for use]]></Text>
            </Expression>
            <Expression xsi:type="MulticastSubject">
              <Name>BehaviorCommands</Name>
            </Expression>
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="1" To="4" Label="Source1" />
            <Edge From="2" To="4" Label="Source2" />
            <Edge From="3" To="4" Label="Source3" />
            <Edge From="4" To="6" Label="Source1" />
            <Edge From="5" To="6" Label="Source2" />
            <Edge From="7" To="8" Label="Source1" />
            <Edge From="8" To="10" Label="Source1" />
            <Edge From="9" To="10" Label="Source2" />
            <Edge From="10" To="12" Label="Source1" />
            <Edge From="11" To="12" Label="Source2" />
            <Edge From="12" To="14" Label="Source1" />
            <Edge From="12" To="16" Label="Source1" />
            <Edge From="12" To="18" Label="Source1" />
            <Edge From="13" To="14" Label="Source2" />
            <Edge From="14" To="20" Label="Source1" />
            <Edge From="15" To="16" Label="Source2" />
            <Edge From="16" To="20" Label="Source2" />
            <Edge From="17" To="18" Label="Source2" />
            <Edge From="18" To="20" Label="Source3" />
            <Edge From="19" To="20" Label="Source4" />
            <Edge From="20" To="22" Label="Source1" />
            <Edge From="21" To="22" Label="Source2" />
            <Edge From="22" To="24" Label="Source1" />
            <Edge From="23" To="24" Label="Source2" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="Annotation">
        <Text><![CDATA[Initialises state variables for speakers and auditory playback]]></Text>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>InitInputVariables</Name>
        <Workflow>
          <Nodes>
            <Expression xsi:type="Annotation">
              <Text><![CDATA[Initialises speaker signal to 0]]></Text>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="ByteProperty">
                <Value>0</Value>
              </Combinator>
            </Expression>
            <Expression xsi:type="Annotation">
              <Text><![CDATA[Stores and publishes initialised signal to other places in workflow for usage]]></Text>
            </Expression>
            <Expression xsi:type="rx:BehaviorSubject">
              <Name>SpeakerSignal</Name>
            </Expression>
            <Expression xsi:type="Annotation">
              <Text><![CDATA[Initialises auditory started to 0 for continuous usage, without shutting down previous parts of workflow]]></Text>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="IntProperty">
                <Value>0</Value>
              </Combinator>
            </Expression>
            <Expression xsi:type="Annotation">
              <Text><![CDATA[Stores and publishes auditory stimulus state to other parts of workflow]]></Text>
            </Expression>
            <Expression xsi:type="rx:BehaviorSubject">
              <Name>AuditoryStarted</Name>
            </Expression>
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="1" To="3" Label="Source1" />
            <Edge From="2" To="3" Label="Source2" />
            <Edge From="4" To="5" Label="Source1" />
            <Edge From="5" To="7" Label="Source1" />
            <Edge From="6" To="7" Label="Source2" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="Annotation">
        <Text><![CDATA[Initialises audio mixer for speaker output]]></Text>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>InitMixer</Name>
        <Workflow>
          <Nodes>
            <Expression xsi:type="Annotation">
              <Text><![CDATA[Creates context for multiple speaker configuration and output]]></Text>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="p1:CreateMixerContext">
                <p1:HostApi>Windows WDM-KS</p1:HostApi>
                <p1:DeviceName>Speakers (XMOS xCORE-200 MC (UAC2.0))</p1:DeviceName>
                <p1:SampleRate>44100</p1:SampleRate>
                <p1:SuggestedLatency xsi:nil="true" />
              </Combinator>
            </Expression>
            <Expression xsi:type="Annotation">
              <Text><![CDATA[INitialises and starts mixer content for every speaker in stream for playback]]></Text>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="p1:StartMixer" />
            </Expression>
            <Expression xsi:type="Annotation">
              <Text><![CDATA[Stores and broadcasts mixer content for use by other parts of workflow]]></Text>
            </Expression>
            <Expression xsi:type="rx:BehaviorSubject">
              <Name>Mixer</Name>
            </Expression>
            <Expression xsi:type="Annotation">
              <Text><![CDATA[Receives buffer data for playback]]></Text>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>Buffer</Name>
            </Expression>
            <Expression xsi:type="Annotation">
              <Text><![CDATA[Receives mixer content for buffer queueing]]></Text>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>Mixer</Name>
            </Expression>
            <Expression xsi:type="Annotation">
              <Text><![CDATA[Maps mixer content to QueueBuffer node]]></Text>
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="Mixer" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="Annotation">
              <Text><![CDATA[Queues audio buffer in mixer for playback to send audio data to speakers ]]></Text>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="p1:QueueBuffer" />
            </Expression>
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="1" To="3" Label="Source1" />
            <Edge From="2" To="3" Label="Source2" />
            <Edge From="3" To="5" Label="Source1" />
            <Edge From="4" To="5" Label="Source2" />
            <Edge From="6" To="7" Label="Source1" />
            <Edge From="7" To="13" Label="Source1" />
            <Edge From="8" To="9" Label="Source1" />
            <Edge From="9" To="11" Label="Source1" />
            <Edge From="10" To="11" Label="Source2" />
            <Edge From="11" To="13" Label="Source2" />
            <Edge From="12" To="13" Label="Source3" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="Annotation">
        <Text><![CDATA[Provides timer for repeated speaker testing]]></Text>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Timer">
          <rx:DueTime>PT0S</rx:DueTime>
          <rx:Period>PT5S</rx:Period>
        </Combinator>
      </Expression>
      <Expression xsi:type="Annotation">
        <Text><![CDATA[Marks beginning of testing audio]]></Text>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="IntProperty">
          <Value>1</Value>
        </Combinator>
      </Expression>
      <Expression xsi:type="Annotation">
        <Text><![CDATA[Broadcasts to other parts of workflow that audio testing has begun]]></Text>
      </Expression>
      <Expression xsi:type="MulticastSubject">
        <Name>AuditoryStarted</Name>
      </Expression>
      <Expression xsi:type="Annotation">
        <Text><![CDATA[Generates test tone for speaker testing]]></Text>
      </Expression>
      <Expression xsi:type="rx:SelectMany">
        <Name>CreateAuditoryCue</Name>
        <Workflow>
          <Nodes>
            <Expression xsi:type="Annotation">
              <Text><![CDATA[Receives trigger input]]></Text>
            </Expression>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="Annotation">
              <Text><![CDATA[Converts input to unit for function generator]]></Text>
            </Expression>
            <Expression xsi:type="Unit" />
            <Expression xsi:type="Annotation">
              <Text><![CDATA[Generates test signal of choice with configurable parameters]]></Text>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="dsp:FunctionGenerator">
                <dsp:BufferLength>1000</dsp:BufferLength>
                <dsp:Frequency>400</dsp:Frequency>
                <dsp:Waveform>Sine</dsp:Waveform>
                <dsp:SampleRate>10000</dsp:SampleRate>
                <dsp:Depth>F32</dsp:Depth>
                <dsp:Amplitude>1</dsp:Amplitude>
                <dsp:Offset>0</dsp:Offset>
                <dsp:Phase>0</dsp:Phase>
              </Combinator>
            </Expression>
            <Expression xsi:type="Annotation">
              <Text><![CDATA[Replicates signal across number of channels present (configurable based on set-up)]]></Text>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="dsp:Tile">
                <dsp:RowTiles>32</dsp:RowTiles>
                <dsp:ColumnTiles>1</dsp:ColumnTiles>
              </Combinator>
            </Expression>
            <Expression xsi:type="Annotation">
              <Text><![CDATA[Scales audio signal if needed]]></Text>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="dsp:ConvertScale">
                <dsp:Depth xsi:nil="true" />
                <dsp:Scale>1</dsp:Scale>
                <dsp:Shift>0</dsp:Shift>
              </Combinator>
            </Expression>
            <Expression xsi:type="Annotation">
              <Text><![CDATA[Takes one buffer of generated audio stimuli so that one single tone is used]]></Text>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Take">
                <rx:Count>1</rx:Count>
              </Combinator>
            </Expression>
            <Expression xsi:type="Annotation">
              <Text><![CDATA[Outputs generated audio buffer to main workflow]]></Text>
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="1" To="3" Label="Source1" />
            <Edge From="2" To="3" Label="Source2" />
            <Edge From="3" To="5" Label="Source1" />
            <Edge From="4" To="5" Label="Source2" />
            <Edge From="5" To="7" Label="Source1" />
            <Edge From="6" To="7" Label="Source2" />
            <Edge From="7" To="9" Label="Source1" />
            <Edge From="8" To="9" Label="Source2" />
            <Edge From="9" To="11" Label="Source1" />
            <Edge From="10" To="11" Label="Source2" />
            <Edge From="11" To="13" Label="Source1" />
            <Edge From="12" To="13" Label="Source2" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="Annotation">
        <Text><![CDATA[Provides audio data to broadcasted subject nodes elsewhere in the workflow (i.e.: to the mixer)]]></Text>
      </Expression>
      <Expression xsi:type="rx:BehaviorSubject">
        <Name>Buffer</Name>
      </Expression>
      <Expression xsi:type="Annotation">
        <Text><![CDATA[Allows processing of audio data before reset]]></Text>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Delay">
          <rx:DueTime>PT0.1S</rx:DueTime>
        </Combinator>
      </Expression>
      <Expression xsi:type="Annotation">
        <Text><![CDATA[Marks end of audio testing]]></Text>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="IntProperty">
          <Value>0</Value>
        </Combinator>
      </Expression>
      <Expression xsi:type="Annotation">
        <Text><![CDATA[Broadcasts to other parts of the workflow that audio testing has ended]]></Text>
      </Expression>
      <Expression xsi:type="MulticastSubject">
        <Name>AuditoryStarted</Name>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="0" To="1" Label="Source1" />
      <Edge From="2" To="3" Label="Source1" />
      <Edge From="4" To="5" Label="Source1" />
      <Edge From="6" To="7" Label="Source1" />
      <Edge From="7" To="9" Label="Source1" />
      <Edge From="8" To="9" Label="Source2" />
      <Edge From="9" To="11" Label="Source1" />
      <Edge From="10" To="11" Label="Source2" />
      <Edge From="11" To="13" Label="Source1" />
      <Edge From="12" To="13" Label="Source2" />
      <Edge From="13" To="15" Label="Source1" />
      <Edge From="14" To="15" Label="Source2" />
      <Edge From="15" To="17" Label="Source1" />
      <Edge From="16" To="17" Label="Source2" />
      <Edge From="17" To="19" Label="Source1" />
      <Edge From="18" To="19" Label="Source2" />
      <Edge From="19" To="21" Label="Source1" />
      <Edge From="20" To="21" Label="Source2" />
    </Edges>
  </Workflow>
</WorkflowBuilder>