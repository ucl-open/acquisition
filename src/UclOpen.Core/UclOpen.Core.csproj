<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>A package providing common classes and types for UclOpen experiments.</Description>
    <PackageTags>Bonsai Rx UclOpen Core</PackageTags>
    <TargetFrameworks>net472</TargetFrameworks>
    <VersionPrefix>0.1.2</VersionPrefix>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="**\*.bonsai" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Bonsai.Core" Version="2.9.0" />
    <PackageReference Include="Bonsai.Harp" Version="3.6.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="YamlDotNet" Version="16.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="DataSchemas\" />
  </ItemGroup>

  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <Exec Command="&#xD;&#xA;          curl --url https://raw.githubusercontent.com/ucl-open/ucl_open_rigs/refs/heads/test_build/src/ucl_open/rigs/schemas/data_types.json -o $(ProjectDir)DataSchemas/ucl_open_data_types.json&#xD;&#xA;          dotnet tool restore&#xD;&#xA;          dotnet tool run bonsai.sgen $(ProjectDir)DataSchemas/ucl_open_data_types.json --namespace UclOpen.Core.DataTypes -n DataTypes.Generated.cs --serializer json" />
  </Target>

</Project>
